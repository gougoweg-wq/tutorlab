{
  "name": "TutorLab",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "hostRequirements": { "cpus": 2, "memory": "8gb" },
  "postCreateCommand": "sh scripts/codespace.sh setup",
  "postStartCommand": "nohup sh scripts/codespace.sh start > /tmp/tutorlab.log 2>&1 &",
  "forwardPorts": [3000],
  "portsAttributes": { "3000": { "label": "TutorLab", "onAutoForward": "openBrowser" } }
}
